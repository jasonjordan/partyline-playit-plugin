<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Partyline WebRTC host (Task 9). A standalone 64-bit console process that runs
    SIPSorcery 6.2.4 in its OWN clean address space. The PlayIt Live plugin
    (PartylinePlugin.dll) launches this exe and talks to it over a length-prefixed
    binary protocol on stdin/stdout. Running WebRTC out-of-process sidesteps both
    the host's shadowing SIPSorcery 5.2.3 AND the 32-bit address-space/stack limits
    that crashed PlayItLive ("guard page cannot be created") when 6.2.4 ran in-proc
    or in a child AppDomain.

    Built x64 so it always gets a large address space (SIPSorcery's ICE/DTLS threads
    then have room for normal 1 MB stacks, exactly as in any standalone 64-bit app).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PartylineWebRtcHost</AssemblyName>
    <RootNamespace>Partyline.WebRtcHost</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Exclude from the parent plugin's default glob if ever built together. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
    <PackageReference Include="Concentus" Version="1.1.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Provides net48 reference assemblies on any build host (and inside nested
         MSBuild invocations), so the plugin build can bundle this exe even where
         the .NET Framework targeting pack isn't separately installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    SIPSorcery 6.2.4 ships a crash bug in STUNErrorCodeAttribute: it parses the
    ERROR-CODE class/number with BitConverter.ToChar(attributeValue, 2/3), which
    reads TWO bytes and walks off the end of a minimal (4-byte, empty reason
    phrase) ERROR-CODE attribute. Cloudflare's TURN Allocate 401 challenge carries
    exactly such an attribute, so the very first TURN response throws
    ArgumentException inside UdpReceiver.EndReceiveFrom, the ICE RTP receive socket
    is torn down, and gathering collapses back to host-only candidates (ICE fails).

    Moving to SIPSorcery 8.x fixes the parser but forces Concentus 2.x, whose Opus
    API is incompatible with this host's encoder/decoder usage. Instead we keep the
    6.2.4 NuGet package (so all transitive dependencies restore normally and the
    code compiles against the unchanged public API) and overwrite just the
    SIPSorcery.dll in the build output with a locally rebuilt 6.2.4 assembly that
    has the two-line STUNErrorCodeAttribute fix (attributeValue[2]/[3]). SIPSorcery
    is not strong-named, so the patched DLL keeps the same assembly identity and
    loads transparently. The swapped DLL is what gets embedded into webrtchost.zip.
  -->
  <Target Name="ApplyPatchedSIPSorcery" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/libs/SIPSorcery.dll"
          DestinationFiles="$(OutDir)SIPSorcery.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Partyline WebRTC host: applied patched SIPSorcery 6.2.4 (STUNErrorCodeAttribute fix) -> $(OutDir)SIPSorcery.dll" />
  </Target>

</Project>
