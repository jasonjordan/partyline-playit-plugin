<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>PartylinePlugin</AssemblyName>
    <RootNamespace>Partyline</RootNamespace>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <!--
    MR-WebRTC primary adapter (task 5.2). Now ON by default: it is the native
    Google-libwebrtc engine with full ICE/TURN relay (required on CGNAT/Starlink),
    where the managed SIPSorcery fallback failed to gather relay candidates. The
    native mrwebrtc.dll is embedded into PartylinePlugin.dll (see below) so the
    build stays single-file. To build the SIPSorcery-only fallback instead:
        dotnet build -p:PartylineMrWebRtc=false
  -->
  <PropertyGroup>
    <PartylineMrWebRtc Condition="'$(PartylineMrWebRtc)' == ''">true</PartylineMrWebRtc>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PartylineMrWebRtc)' == 'true'">
    <DefineConstants>$(DefineConstants);PARTYLINE_MRWEBRTC</DefineConstants>
  </PropertyGroup>

  <!-- The Tests/ folder is a separate net8.0 xUnit+FsCheck project (mirrors plugin
       logic for off-Windows verification). Exclude it from this net48 plugin build
       so its sources are not globbed into the plugin assembly. -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**/*" />
  </ItemGroup>

  <!--
    Single plugin entry point: NewPlugin in PartylineScript.cs (WebRTC/Opus
    co-host mesh with Cloudflare signaling-only transport).

    The files below are the SUPERSEDED older plugin (PartylinePlugin: an
    HttpListener + CoHostManager WebRTC attempt) and its UI/helpers. They define
    a second Plugin<IPlayItLiveApp> entry class and are NOT referenced by
    NewPlugin/PartylineScript.cs, so they are excluded from the DLL build to
    leave exactly one entry point. The source files are kept on disk for
    reference — this only removes them from compilation.
  -->
  <ItemGroup>
    <Compile Remove="PartylinePlugin.cs" />
    <Compile Remove="CoHostManager.cs" />
    <Compile Remove="CoHostPage.cs" />
    <Compile Remove="PartylineMixerForm.cs" />
    <Compile Remove="PartylineStatusStrip.cs" />
  </ItemGroup>

  <!--
    Single-file packaging: Costura.Fody embeds all copy-local managed dependency
    DLLs (SIPSorcery, Concentus, Newtonsoft.Json, and their managed closure:
    BouncyCastle, DnsClient, Microsoft.Extensions.Logging.Abstractions, etc.)
    as resources INSIDE PartylinePlugin.dll and loads them at runtime via an
    AssemblyResolve handler. Result: you copy ONLY PartylinePlugin.dll into the
    PlayIt Live Plugins folder — no loose dependency DLLs.

    NOTE: this only works for managed assemblies. If you enable the MR-WebRTC
    primary adapter (-p:PartylineMrWebRtc=true), its native mrwebrtc.dll is NOT
    managed and CANNOT be embedded — it must still be shipped as a loose native
    file next to the plugin. The default SIPSorcery+Concentus build is fully
    managed and rolls up into the single DLL.
  -->
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      Concentus: pure-managed C# Opus codec used by the SIPSorcery + Concentus
      fallback IWebRtcPeer adapter (task 5.3). Pinned to 1.1.7, the last release
      with the classic synchronous OpusEncoder/OpusDecoder API (no Span<T>), which
      compiles cleanly on net48. Pure managed, so it restores on any OS and never
      introduces a native DLL/bitness dependency (unlike MR-WebRTC's mrwebrtc.dll).
    -->
    <PackageReference Include="Concentus" Version="1.1.7" />
  </ItemGroup>

  <ItemGroup Condition="'$(PartylineMrWebRtc)' == 'true'">
    <!-- Pinned: last published MR-WebRTC release (project archived since 2022).
         GeneratePathProperty exposes $(PkgMicrosoft_MixedReality_WebRTC) so the
         native engine can be embedded below for single-file deployment. -->
    <PackageReference Include="Microsoft.MixedReality.WebRTC" Version="2.0.2" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Single-file native packaging: embed mrwebrtc.dll (both architectures) as
    manifest resources INSIDE PartylinePlugin.dll. Costura only embeds managed
    assemblies; the native engine is unmanaged, so we embed it ourselves and
    extract + LoadLibrary it at startup (MixedRealityWebRtcLoader). Result: a
    single PartylinePlugin.dll with no loose native files to copy.
  -->
  <ItemGroup Condition="'$(PartylineMrWebRtc)' == 'true'">
    <EmbeddedResource Include="$(PkgMicrosoft_MixedReality_WebRTC)\runtimes\win10-x86\native\mrwebrtc.dll">
      <LogicalName>Partyline.native.x86.mrwebrtc.dll</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgMicrosoft_MixedReality_WebRTC)\runtimes\win10-x64\native\mrwebrtc.dll">
      <LogicalName>Partyline.native.x64.mrwebrtc.dll</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Update HintPath to your PlayIt Live install location -->
    <Reference Include="PlayItLive">
      <HintPath>C:\Program Files (x86)\PlayIt Live\PlayItLive.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
