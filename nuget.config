<?xml version="1.0" encoding="utf-8"?>
<!--
  Ensures the plugin restores SIPSorcery / Concentus / Newtonsoft.Json from
  the public nuget.org feed. Added because a build hit NETSDK1064
  ("Package Concentus, version 1.1.7 was not found") which happens when the
  active NuGet source doesn't carry the package or a partial restore is cached.
  <clear/> drops any inherited/private feeds so the restore is deterministic.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
